---
// Civit shared application shell — Prompt 1B.
// Semantic landmarks, skip link, responsive nav placeholders, theme system.
// Static-only: no analytics, no remote requests, no accounts (Constitution).
import '../styles/global.css';
import '../styles/theme.css';
import ThemeToggle from '../components/ThemeToggle.svelte';
import { PREPAINT_SCRIPT } from '../lib/theme/theme';

interface Props {
  /** Page title text; the site suffix is appended below. */
  title: string;
  /** Meta description for the page. Required to keep titles/descriptions honest per page. */
  description: string;
}

const { title, description } = Astro.props;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/tools/', label: 'Tools' },
];
const currentPath = Astro.url.pathname.replace(/\/index\.html$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Civit</title>
    <meta name="description" content={description} />
    <!-- No analytics, no telemetry, no external fonts, no runtime CDN requests. -->
    <!-- Apply stored/OS theme before first paint (no flash of wrong theme). -->
    <script is:inline define:vars={{ script: PREPAINT_SCRIPT }}>{script}</script>
  </head>
  <body class="flex min-h-screen flex-col bg-[var(--civit-bg)] text-[var(--civit-text)] antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:rounded focus:bg-[var(--civit-accent)] focus:px-3 focus:py-2 focus:text-[var(--civit-bg)]"
      >Skip to main content</a
    >

    <header class="border-b border-[var(--civit-border)] bg-[var(--civit-surface)]">
      <div class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-4">
        <a href="/" class="text-lg font-bold tracking-tight">Civit</a>
        <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto">
          <ul class="flex gap-4 text-sm">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                  class:list={[
                    'rounded px-1 py-0.5 underline-offset-4 hover:underline',
                    currentPath === link.href ? 'font-semibold text-[var(--civit-accent)]' : 'text-[var(--civit-muted)]',
                  ]}>{link.label}</a
                >
              </li>
            ))}
          </ul>
        </nav>
        <span class="ml-auto"><ThemeToggle client:load /></span>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-[var(--civit-border)] bg-[var(--civit-surface)]">
      <div class="mx-auto max-w-3xl px-6 py-6 text-sm text-[var(--civit-muted)]">
        <p>
          Built with Astro (static output), Svelte 5, TypeScript, and Tailwind CSS v4.
          Everything runs locally in your browser — no backend, no analytics.
        </p>
        <p class="mt-2">
          Honest phase status lives in
          <code class="rounded bg-[var(--civit-bg)] px-1">docs/BUILD_STATUS.md</code> in the
          repository. This project is a work in progress.
        </p>
      </div>
    </footer>
  </body>
</html>
