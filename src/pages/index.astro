---
// Civit landing page — Prompt 1A foundation, shell from Prompt 1B,
// search + category browsing wired in Prompt 2A.
// Static HTML first: the catalogue summary below is server-rendered and works
// without JavaScript; the ToolSearch island adds live filtering progressively.
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolkitStatus from '../components/ToolkitStatus.svelte';
import ToolSearch from '../components/ToolSearch.svelte';
import { publishedTools } from '../lib/tools/registry';
import { plannedTools } from '../lib/tools/catalogue';
import { toolPath } from '../lib/tools/routes';
import { TOOL_CATEGORIES, type ToolCategory } from '../lib/tools/types';
---

<BaseLayout
  title="Local-first browser toolkit (work in progress)"
  description="Civit is a work-in-progress, privacy-focused browser toolkit for developers, designers, and digital creators. Utilities run locally in your browser."
>
      <p class="text-sm font-semibold uppercase tracking-wide text-base-content/70">
        Work in progress — Phase 2 shell
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">Civit</h1>
      <p class="mt-4 text-lg leading-relaxed">
        A planned <strong>local-first, privacy-focused browser toolkit</strong> for developers,
        designers, and digital creators — small, focused utilities that process your text and files
        in your own browser wherever practical.
      </p>

      <!-- Short privacy statement (Prompt 2A requirement). -->
      <section aria-labelledby="privacy-heading" class="card mt-8 border border-[var(--civit-border-subtle)] bg-base-200 shadow-sm">
        <div class="card-body gap-0">
          <h2 id="privacy-heading" class="card-title text-xl">Privacy by design</h2>
          <p class="mt-2 leading-relaxed">
            Tools run entirely in your browser. Your content is never uploaded, there is no
            backend, no accounts, and no analytics. Anything you paste here stays on this device.
          </p>
        </div>
      </section>

      <!-- Prominent tool search + category browsing (Prompt 2A). Server-rendered
           summary works without JS; the island adds live filtering. -->
      <section aria-labelledby="find-heading" class="mt-8">
        <h2 id="find-heading" class="text-xl font-semibold">Find a tool</h2>
        <p class="mt-2 text-base-content/70">
          {publishedTools.length} of {publishedTools.length + plannedTools.length} planned MVP
          tools are implemented and searchable today. Planned tools appear on the
          <a href="/tools/" class="link link-primary">tools page</a> marked honestly as not built yet.
        </p>
        <div class="mt-4">
          <ToolSearch client:load candidates={[...publishedTools]} />
        </div>
        <noscript>
          <p class="mt-3 text-sm">JavaScript is disabled: browse tools directly on the
            <a href="/tools/" class="link link-primary">tools page</a>.</p>
        </noscript>
        <ul class="mt-4 flex flex-wrap gap-2">
          {TOOL_CATEGORIES.map((cat: ToolCategory) => {
            const count = publishedTools.filter((t) => t.category === cat).length;
            return (
              <li class="badge badge-primary badge-soft capitalize normal-case">{cat}: {count}</li>
            );
          })}
        </ul>
      </section>

      <section aria-labelledby="status-heading" class="card mt-8 border border-[var(--civit-border-subtle)] bg-base-200 shadow-sm">
        <div class="card-body gap-0"><h2 id="status-heading" class="card-title text-xl">Current status</h2>
        <p class="mt-2 leading-relaxed">
          Civit is being built one vertical slice at a time. The
          <a href={toolPath('json-formatter')} class="link link-primary">JSON Formatter</a>
          is implemented and usable now. The remaining utilities (word counter, colour tools,
          and others) are <strong>planned but not yet implemented</strong>. Nothing on this page
          sends your data anywhere — there is no backend, no account system, and no analytics.
        </p>
        <ul class="mt-4 list-disc space-y-1 pl-5 text-base-content/70">
          <li>Available now: JSON Formatter (format/minify, fully local).</li>
          <li>Planned later: installable PWA / offline support, then Docker self-hosting.</li>
        </ul>
      </div></section>

      <section aria-labelledby="island-heading" class="mt-8">
        <h2 id="island-heading" class="text-xl font-semibold">Interactive check (Svelte&nbsp;5 island)</h2>
        <p class="mt-2 text-base-content/70">
          The control below exists only to verify that interactive components compile and hydrate
          correctly. Everything it shows is computed locally in your browser.
        </p>
        <div class="mt-4">
          <ToolkitStatus client:load />
        </div>
      </section>
</BaseLayout>
