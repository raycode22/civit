---
// Civit static 404 page — Prompt 2A (build guide: "A static 404 page").
// Astro emits dist/404.html; Cloudflare Pages serves it for unknown paths at
// deployment time (verified in Phase 5). Honest links to real routes only.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page does not exist on Civit."
>
  <h1 class="text-3xl font-bold tracking-tight">Page not found</h1>
  <p class="mt-4 text-lg leading-relaxed">
    The page you requested does not exist. Planned tools intentionally have no pages until they
    are implemented and tested, so a link to a tool that “should” be here may simply mean that
    tool is not built yet.
  </p>
  <nav aria-label="Recovery links" class="mt-8 flex flex-wrap gap-3">
    <a href="/" class="btn btn-primary">Go to the home page</a>
    <a href="/tools/" class="btn btn-outline btn-primary">Browse all tools</a>
  </nav>
</BaseLayout>
