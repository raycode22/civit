---
// Civit tools catalogue route — Phase 2, Prompt 2B (registry-driven).
// The typed registry is the single source of discovery metadata. Only
// implemented/published tools are listed as working; planned tools are
// described honestly as not built yet. No hand-maintained duplicate lists.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedTools } from '../../lib/tools/registry';
import { toolPath } from '../../lib/tools/routes';
import { TOOL_CATEGORIES, type ToolCategory } from '../../lib/tools/types';
---

<BaseLayout
  title="Tools"
  description="Planned home of the Civit local-first browser toolkit. Individual utilities have not been implemented yet."
>
  <h1 class="text-3xl font-bold tracking-tight">Tools</h1>
  <p class="mt-4 text-lg leading-relaxed">
    This is where the Civit toolkit catalogue will live. Each utility will get its own page under
    <code class="rounded bg-base-200 px-1">/tools/&lt;tool-name&gt;/</code> and will
    process your content locally in this browser wherever practical.
  </p>

  {publishedTools.length > 0 ? (
    <section aria-labelledby="tools-available-heading" class="mt-8">
      <h2 id="tools-available-heading" class="text-xl font-bold">Available tools</h2>
      <ul class="card-group mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {publishedTools.map((tool) => (
          <li class="card border border-[var(--civit-border-subtle)] bg-base-200 shadow-sm">
            <div class="card-body gap-0">
              <h3 class="card-title text-lg">
                <a href={toolPath(tool.slug)} class="link link-primary">{tool.name}</a>
              </h3>
              <p class="mt-1 text-sm text-base-content/80">{tool.shortDescription}</p>
              <span class="badge badge-outline mt-3 capitalize">{tool.category}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section aria-labelledby="tools-status-heading" class="card mt-8 border border-[var(--civit-border-subtle)] bg-base-200 shadow-sm">
      <div class="card-body gap-0">
        <h2 id="tools-status-heading" class="card-title text-xl">Status</h2>
        <p class="mt-2 leading-relaxed">
          <strong>No tools are implemented yet.</strong> The project is at the application-shell
          stage (Phase 2). Tool pages will be added one vertical slice at a time, each with its own
          tests, as recorded honestly in <code class="rounded bg-base-300 px-1">docs/BUILD_STATUS.md</code>.
        </p>
        <ul class="mt-4 list-disc space-y-1 pl-5 text-base-content/70">
          <li>Planned: a curated collection of browser-side utilities for developers, designers, and digital creators.</li>
          <li>Not built yet: any individual utility. Planned tools are intentionally hidden until implemented and tested.</li>
        </ul>
      </div>
    </section>
  )}

  <section aria-labelledby="tools-categories-heading" class="mt-8">
    <h2 id="tools-categories-heading" class="text-xl font-bold">Categories</h2>
    <p class="mt-2 text-sm text-base-content/70">
      Category browsing is scaffolded on the registry categories below. Categories with no
      published tools show an explicit empty state rather than being omitted silently.
    </p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {TOOL_CATEGORIES.map((cat: ToolCategory) => {
        const count = publishedTools.filter((t) => t.category === cat).length;
        return (
          <li class="badge badge-neutral capitalize">{cat}: {count > 0 ? `${count} available` : 'none published yet'}</li>
        );
      })}
    </ul>
  </section>

  <p class="mt-8 text-sm">
    <a href="/" class="link link-primary">← Back to the Civit home page</a>
  </p>
</BaseLayout>
