    "@vitejs/devtools": "^0.7.1",
    "@volar/typescript": "~2.4.0",
    "@vue/language-core": "~3.2.0 || ~3.3.0",
    "esbuild": "^0.27.0 || ^0.28.0",
    "jiti": ">=1.21.0",
    "less": "^4.0.0",
    "publint": "^0.3.8",
    "sass": "^1.70.0",
    "sass-embedded": "^1.70.0",
    "stylus": ">=0.54.8",
    "sugarss": "^5.0.0",
    "terser": "^5.16.0",
    "tsx": "^4.8.1",
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "unplugin-unused": ">=0.5.0",
    "unrun": "*",
    "vue-tsc": "~3.2.0 || ~3.3.0",
    "yaml": "^2.4.2"
  },
