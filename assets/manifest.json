{
  "version": 1,
  "target": "docker",
  "description": "Asset localisation register for the Civit Docker/offline image. Every entry must be present in the final runtime image; the build fails if any required entry is missing or has the wrong hash.",
  "toolIds": [
    "base64-image-encoder",
    "px-to-rem",
    "word-counter",
    "favicon-generator",
    "image-clipper",
    "metadata-stripper",
    "image-de-skew",
    "image-masker",
    "large-type",
    "paper-sizes",
    "glyph-browser"
  ],
  "buildOutput": [
    {
      "path": "index.html",
      "type": "html",
      "required": true,
      "notes": "App shell entry point"
    },
    {
      "path": "_headers",
      "type": "headers",
      "required": true,
      "notes": "Nginx/Page cache and security headers"
    },
    {
      "path": "theme-init.js",
      "type": "js",
      "required": true,
      "notes": "Theme initialisation script"
    },
    {
      "path": "manifest.webmanifest",
      "type": "json",
      "required": true,
      "notes": "PWA manifest"
    },
    {
      "path": "sw.js",
      "type": "js",
      "required": true,
      "notes": "Service worker"
    },
    {
      "path": "favicon.svg",
      "type": "image",
      "required": true,
      "notes": "Site favicon"
    },
    {
      "path": "robots.txt",
      "type": "text",
      "required": false,
      "notes": "Robots exclusion file"
    },
    {
      "path": "icons",
      "type": "directory",
      "required": true,
      "notes": "PWA icons"
    },
    {
      "path": "_app",
      "type": "directory",
      "required": true,
      "notes": "SvelteKit client runtime and hashed assets"
    },
    {
      "path": "tools",
      "type": "directory",
      "required": true,
      "notes": "Prerendered tool route HTML via SvelteKit entries (FR-43); per-tool files are checked through toolIds"
    },
    {
      "path": "credits.html",
      "type": "html",
      "required": true,
      "notes": "Credits/licences page (Constitution §17)"
    }
  ],
  "projectFiles": [
    {
      "path": "CREDITS.md",
      "type": "text",
      "required": true,
      "notes": "Third-party licences and credits (Constitution §17)"
    },
    {
      "path": "assets/fonts",
      "type": "directory",
      "required": false,
      "notes": "Localised fonts for Docker/offline runtime"
    },
    {
      "path": "assets/wasm",
      "type": "directory",
      "required": false,
      "notes": "Localised WASM binaries (e.g. ffmpeg.wasm) for Docker/offline runtime"
    },
    {
      "path": "assets/models",
      "type": "directory",
      "required": false,
      "notes": "Localised ML model weights for Docker/offline runtime"
    }
  ]
}
